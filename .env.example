# ─────────────────────────────────────────────────────────────────────────────
# MindGuard — environment variables template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────
# Required — app will not start without these
# ─────────────────────────────────────────────
JWT_SECRET=                          # Generate: python -c "import secrets; print(secrets.token_hex(32))"
SUPABASE_URL=                        # Settings → API → Project URL
SUPABASE_ANON_KEY=                   # Settings → API → anon/public key


# ─────────────────────────────────────────────
# Admin provisioning (fresh DBs / startup)
# ─────────────────────────────────────────────
# Password for the seeded admin@mindguard.org account on a FRESH database only.
# If unset a random password is generated and logged once. Never set this to a
# guessable value in production.
MINDGUARD_ADMIN_PASSWORD=
# Comma-separated emails to promote to admin at startup (existing users only —
# accounts are never auto-created). Each promotion is written to the audit log.
MINDGUARD_BOOTSTRAP_ADMIN_EMAIL=
# Rotate an existing admin's password live with:
#   curl -X POST <base>/api/auth/change-password \
#     -H "Authorization: Bearer <token>" \
#     -H "Content-Type: application/json" \
#     -d '{"current_password":"<old>","new_password":"<new>"}'
# Environment: "production" or unset/anything else (development).
# MUST be set to "production" in production:
#   - No known-password demo accounts are seeded (only admin@mindguard.org, with a
#     random password unless MINDGUARD_ADMIN_PASSWORD is set).
#   - Demo data/communications are skipped.
# Development (unset): demo accounts (counsellor@/student@/demo@mindguard.org,
# password "password") and demo communications are seeded for local testing.
MINDGUARD_ENV=


# ─────────────────────────────────────────────
# Hugging Face model
# ─────────────────────────────────────────────
HF_REPO_ID=kopiyodiana/mindguard-mental-roberta
HF_TOKEN=                            # Required only for private repos
HF_WEIGHTS_FILE=mindguard_best_weights.pt
HF_TOKENIZER_SUBFOLDER=mindguard_tokenizer
HF_CACHE_DIR=.cache/huggingface


# ─────────────────────────────────────────────
# Consent email delivery (optional)
# ─────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173   # Your public URL (e.g. https://your-app.up.railway.dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ─────────────────────────────────────────────
# PII encryption at rest (required in production)
# ─────────────────────────────────────────────
# 64 hex chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Unset locally -> a dev key is auto-generated next to the SQLite DB (see crypto.py).
ENCRYPTION_KEY=
# Gate analysis behind accepted, non-expired, non-revoked consent (true/false)
ENFORCE_CONSENT_ANALYSIS=true
CONSENT_EXPIRY_DAYS=30
CONSENT_REMINDER_DAYS=3,7


# ─────────────────────────────────────────────
# Email sending (Resend preferred, SMTP fallback)
# ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=MindGuard <noreply@mindguard.ai>
DEMO_NOTIFY_EMAIL=


# ─────────────────────────────────────────────
# Data source API keys (optional)
# ─────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=


# ─────────────────────────────────────────────
# Legacy Streamlit app only (ignore for FastAPI)
# ─────────────────────────────────────────────
# SECRET_KEY=                        # Only used by auth.py (Streamlit), NOT by backend/auth.py
# GOOGLE_CLIENT_ID=                  # Only for Streamlit Google OAuth
# GOOGLE_CLIENT_SECRET=              # Only for Streamlit Google OAuth
# GOOGLE_REDIRECT_URI=               # Only for Streamlit Google OAuth
