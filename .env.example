# ─────────────────────────────────────────────────────────────────────────────
# MindGuard — environment variables template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────
# Required — app will not start without these
# ─────────────────────────────────────────────
JWT_SECRET=                          # Generate: python -c "import secrets; print(secrets.token_hex(32))"
SUPABASE_URL=                        # Settings → API → Project URL
SUPABASE_ANON_KEY=                   # Settings → API → anon/public key


# ─────────────────────────────────────────────
# Admin provisioning (fresh DBs / startup)
# ─────────────────────────────────────────────
# Password for the seeded admin@mindguard.org account on a FRESH database only.
# If unset a random password is generated and logged once. Never set this to a
# guessable value in production.
MINDGUARD_ADMIN_PASSWORD=
# Comma-separated emails to promote to admin at startup (existing users only —
# accounts are never auto-created). Each promotion is written to the audit log.
MINDGUARD_BOOTSTRAP_ADMIN_EMAIL=
# Rotate an existing admin's password live with:
#   curl -X POST <base>/api/auth/change-password \
#     -H "Authorization: Bearer <token>" \
#     -H "Content-Type: application/json" \
#     -d '{"current_password":"<old>","new_password":"<new>"}'
# Environment: "production" or unset/anything else (development).
# MUST be set to "production" in production:
#   - No known-password demo accounts are seeded (only admin@mindguard.org, with a
#     random password unless MINDGUARD_ADMIN_PASSWORD is set).
#   - Demo data/communications are skipped.
# Development (unset): demo accounts (counsellor@/student@/demo@mindguard.org,
# password "password") and demo communications are seeded for local testing.
MINDGUARD_ENV=


# ─────────────────────────────────────────────
# Hugging Face model
# ─────────────────────────────────────────────
HF_REPO_ID=kopiyodiana/mindguard-mental-roberta
HF_TOKEN=                            # Required only for private repos
HF_WEIGHTS_FILE=mindguard_best_weights.pt
HF_TOKENIZER_SUBFOLDER=mindguard_tokenizer
HF_CACHE_DIR=.cache/huggingface


# ─────────────────────────────────────────────
# Consent email delivery (optional)
# ─────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173   # Your public URL (e.g. https://your-app.up.railway.dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ─────────────────────────────────────────────
# PII encryption at rest (required in production)
# ─────────────────────────────────────────────
# 64 hex chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Unset locally -> a dev key is auto-generated next to the SQLite DB (see crypto.py).
ENCRYPTION_KEY=
# Gate analysis behind accepted, non-expired, non-revoked consent (true/false)
ENFORCE_CONSENT_ANALYSIS=true
CONSENT_EXPIRY_DAYS=30
CONSENT_REMINDER_DAYS=3,7


# ─────────────────────────────────────────────
# Email sending (Resend preferred, SMTP fallback)
# ─────────────────────────────────────────────
RESEND_API_KEY=
# Svix-style signing secret for POST /webhooks/email/resend (Resend →
# Webhooks → signing secret). REQUIRED for webhooks: without it every event is
# rejected with 401 (the verifier fails closed).
RESEND_WEBHOOK_SECRET=
# Max clock skew (seconds) tolerated when verifying webhook signatures.
WEBHOOK_TOLERANCE_SECONDS=300
EMAIL_FROM=MindGuard <noreply@mindguard.ai>
DEMO_NOTIFY_EMAIL=            # Address that receives new demo-request notifications


# ─────────────────────────────────────────────
# reCAPTCHA v3 (Request Demo form + auth)
# ─────────────────────────────────────────────
# Server-side secret key (Google reCAPTCHA admin console). Enforced fails-closed
# on login/register/Google-auth and the demo form when set; skipped when unset.
RECAPTCHA_SECRET=
# Frontend site key (marketing): put in marketing/.env as NEXT_PUBLIC_RECAPTCHA_SITE_KEY.
# Frontend site key (product): put in frontend/.env as VITE_RECAPTCHA_SITE_KEY.


# ─────────────────────────────────────────────
# Origins / CSRF (production)
# ─────────────────────────────────────────────
# Comma-separated origins allowed to make browser (cross-origin) requests.
# Default: localhost dev origins. In production add your real frontend + marketing
# origins, e.g. CORS_ORIGINS=https://app.mindguard.ai,https://mindguard.ai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Extra origins trusted for CSRF Origin checks on top of CORS_ORIGINS
# (e.g. the marketing site when it proxies /api requests server-side).
TRUSTED_ORIGINS=


# ─────────────────────────────────────────────
# Runtime (optional)
# ─────────────────────────────────────────────
# Directory holding the SQLite database file (defaults to the repo root).
MINDGUARD_DB_DIR=
# Serve the strict Content-Security-Policy on HTML responses (true/false).
MINDGUARD_CSP=true
# Optional directory of secret files (one file per secret, name = secret key).
# e.g. /run/secrets with a file named "RESEND_API_KEY". Loaded before env vars,
# so env vars win. See backend/secrets_manager.py.
SECRETS_FILE_DIR=
# Skip the startup RAM check (for constrained hosts that pre-load weights off-box).
# false/true — only set true when you know the model fits in memory.
MINDGUARD_SKIP_MEM_CHECK=false


# ─────────────────────────────────────────────
# Email outbox worker (optional)
# ─────────────────────────────────────────────
# Bulk consent dispatch enqueues emails to the outbox; this worker drains them.
# Seconds between drain passes (default 3).
EMAIL_WORKER_POLL_SECONDS=3
# Max outbox rows delivered per pass (default 50).
EMAIL_WORKER_BATCH_SIZE=50
# Max delivery attempts per message before it is abandoned as failed (default 5).
EMAIL_WORKER_MAX_ATTEMPTS=5


# ─────────────────────────────────────────────
# Error monitoring — Sentry (optional)
# ─────────────────────────────────────────────
# Backend: https://sentry.io settings -> project DSN. Unset disables Sentry.
SENTRY_DSN=
# Environment tag attached to events ("production", "staging", "development").
SENTRY_ENVIRONMENT=production
# % of requests traced for performance (0.0 to 1.0; default 0.1).
SENTRY_TRACES_SAMPLE_RATE=0.1


# ─────────────────────────────────────────────
# Data source API keys (optional)
# ─────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=


# ─────────────────────────────────────────────
# Legacy Streamlit app only (ignore for FastAPI)
# ─────────────────────────────────────────────
# SECRET_KEY=                        # Only used by auth.py (Streamlit), NOT by backend/auth.py
# GOOGLE_CLIENT_ID=                  # Only for Streamlit Google OAuth
# GOOGLE_CLIENT_SECRET=              # Only for Streamlit Google OAuth
# GOOGLE_REDIRECT_URI=               # Only for Streamlit Google OAuth
