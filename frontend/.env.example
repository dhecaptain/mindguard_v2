# MindGuard web frontend environment variables.
# Copy to .env.local and adjust (vite reads .env.local, which is gitignored).

# Base URL of the MindGuard backend API. In dev, the vite dev server proxies
# /api to http://127.0.0.1:8000, so this can stay blank. Set it to the deployed
# API URL for production builds (e.g. https://your-app.up.railway.dev).
VITE_API_BASE_URL=

# Build identifier reported to Sentry as the release tag.
VITE_APP_VERSION=2.0.0

# reCAPTCHA v3 site key (public, safe to expose). Omit to skip captcha in dev.
VITE_RECAPTCHA_SITE_KEY=

# Sentry error monitoring (optional). Omit all VITE_SENTRY_* to disable the SDK.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
