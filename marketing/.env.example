# URL of the MindGuard product API (used for the /api/* rewrite proxy).
# In dev: http://localhost:8000
# In prod: https://your-app.up.railway.dev
MINDGUARD_API_URL=http://localhost:8000

# reCAPTCHA v3 site key (public, safe to expose). Omit to skip captcha in dev.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Plausible privacy-first analytics (optional). Set to your site domain to enable
# the Plausible script (no cookies). Omit for local dev.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Sentry error monitoring (optional). Omit all of these for local dev / hermetic
# e2e — the SDK is a no-op without a DSN. In production set SENTRY_DSN and, for
# sourcemap uploads at build time, SENTRY_ORG + SENTRY_PROJECT + SENTRY_AUTH_TOKEN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
