# Railway Docker deployment for MindGuard.
# Builds the Vite frontend, then serves it from FastAPI on Railway's dynamic PORT.

FROM node:20-alpine AS frontend

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/requirements.txt
# CPU-only torch first: the default PyPI wheel bundles CUDA (~2GB), which blows
# the free-tier 10-minute build cap and the 4GB image limit. Inference here runs
# on CPU, so the CPU wheel satisfies torch>=2.2.0 and is ~10x smaller.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch
RUN pip install --no-cache-dir gunicorn -r requirements.txt

COPY backend/ /app/backend/
COPY scraper_worker.py /app/scraper_worker.py
COPY --from=frontend /app/dist /app/frontend

ENV FRONTEND_DIR=/app/frontend
ENV PYTHONPATH=/app
ENV API_HOST=0.0.0.0
ENV HF_CACHE_DIR=/tmp/huggingface

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import os, httpx; port = os.getenv('PORT', '8000'); httpx.get(f'http://127.0.0.1:{port}/api/v1/healthz', timeout=5).raise_for_status()"

CMD ["sh", "-c", "gunicorn backend.main:app --worker-class uvicorn.workers.UvicornWorker --workers 1 --bind 0.0.0.0:${PORT:-8000} --timeout 180 --keep-alive 5 --log-level info"]

